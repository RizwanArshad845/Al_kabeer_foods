# Local development only (`npm run dev`). Copy to `.env.local` and fill in your key.
# In production the key lives in Secret Manager as ALKABEER_GEMINI_API_KEY:
#   npx firebase-tools functions:secrets:set ALKABEER_GEMINI_API_KEY --project tech-poc-a5f7a
GEMINI_API_KEY=your-gemini-api-key-here

# Optional. Any Gemini model that accepts images. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
